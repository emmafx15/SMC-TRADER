<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SMC TRADER - Verify</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Inter,sans-serif}
body{min-height:100vh;background:#020a06;color:#fff;display:flex;justify-content:center;align-items:center;padding:16px;position:relative}
.bg{position:fixed;inset:0;background:linear-gradient(rgba(2,10,6,0.65), rgba(2,10,6,0.9)), url('https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=1920&q=80');background-size:cover;background-position:center;z-index:0}
.card{position:relative;z-index:10;width:400px;padding:28px;border-radius:24px;background:rgba(10,22,16,0.9);border:1px solid rgba(0,255,136,0.3);backdrop-filter:blur(22px);text-align:center}
.otp-box{display:flex;gap:7px;justify-content:center;margin:16px 0}
.otp{width:40px;height:50px;border-radius:10px;border:1px solid rgba(255,255,255,0.15);background:rgba(0,0,0,0.4);color:#00ff88;font-size:20px;font-weight:900;text-align:center;outline:none}
.btn{width:100%;padding:13px;border-radius:12px;border:0;font-weight:900;cursor:pointer;margin-top:12px;font-size:14px}
.btn-green{background:linear-gradient(135deg,#00ff88,#00cc6a);color:#000}
.btn-gray{background:rgba(255,255,255,0.08);color:#fff}
.code-preview{background:rgba(0,255,136,0.12);border:1px dashed #00ff88;padding:10px;border-radius:12px;margin:12px 0}
.msg{padding:10px 14px;border-radius:10px;font-size:12px;margin-bottom:12px;display:none}
.msg.ok{background:rgba(0,255,136,0.15);border:1px solid #00ff88;color:#00ff88;display:block}
.msg.err{background:rgba(255,68,68,0.15);border:1px solid #ff4444;color:#ff8888;display:block}
.step{font-size:10px;opacity:0.5;letter-spacing:1px;text-align:left}
</style>
</head>
<body>
<div class="bg"></div>
<div class="card">
<div class="step">Step 2 of 4 • Verify</div>
<h2 style="font-size:20px;font-weight:900">Check your email</h2>
<p style="font-size:12px;opacity:0.6;margin:6px 0">Code sent to<br><b id="emailDisplay" style="color:#00ff88"></b></p>
<div id="msg" class="msg"></div>
<div class="otp-box">
<input class="otp" id="o1" maxlength="1" oninput="move(1)"><input class="otp" id="o2" maxlength="1" oninput="move(2)"><input class="otp" id="o3" maxlength="1" oninput="move(3)"><input class="otp" id="o4" maxlength="1" oninput="move(4)"><input class="otp" id="o5" maxlength="1" oninput="move(5)"><input class="otp" id="o6" maxlength="1">
</div>
<div class="code-preview"><span style="font-size:10px;opacity:0.7">YOUR CODE:</span><br><b id="codeDisplay" style="font-size:22px;color:#00ff88;letter-spacing:3px"></b></div>
<button class="btn btn-green" onclick="verify()">CONFIRM EMAIL →</button>
<button class="btn btn-gray" onclick="resend()">Resend code</button>
</div>
<script>
let pending=JSON.parse(localStorage.getItem('smc_pending')||'null');
if(!pending||!pending.email){ window.location.href='register.html'; }
document.getElementById('emailDisplay').innerText=pending.email;
document.getElementById('codeDisplay').innerText=pending.code;
function showMsg(t,ok){const m=document.getElementById('msg');m.textContent=t;m.className='msg '+(ok?'ok':'err');}
function move(n){const el=document.getElementById('o'+n);if(el.value&&n<6)document.getElementById('o'+(n+1)).focus();}
function getCode(){let c='';for(let i=1;i<=6;i++)c+=document.getElementById('o'+i).value;return c;}
function verify(){
 const e=getCode();
 if(e.length!==6)return showMsg('Enter 6 digits',false);
 if(e!==pending.code)return showMsg('Wrong! Correct is '+pending.code,false);
 pending.verified=true;
 localStorage.setItem('smc_pending',JSON.stringify(pending));
 showMsg('Verified ✅ Redirecting to password page...',true);
 setTimeout(()=>{window.location.href='password.html';},1000);
}
function resend(){
 const newCode=Math.floor(100000+Math.random()*900000).toString();
 pending.code=newCode;
 localStorage.setItem('smc_pending',JSON.stringify(pending));
 document.getElementById('codeDisplay').innerText=newCode;
 for(let i=1;i<=6;i++)document.getElementById('o'+i).value='';
 showMsg('New code: '+newCode,true);
}
</script>
</body>
</html>
